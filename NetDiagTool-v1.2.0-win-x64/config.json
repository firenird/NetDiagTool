{
  "SchemaVersion": 3,
  "Ping": {
    "Count": 4,
    "TimeoutMs": 3000,
    "IntervalMs": 500,
    "BufferSize": 32
  },
  "Tcp": {
    "TimeoutMs": 3000,
    "Retries": 0,
    "ReplyTimeoutMs": 3000,
    "Encoding": "UTF-8"
  },
  "Bulk": {
    "PingConcurrency": 10,
    "TcpConcurrency": 10,
    "TraceConcurrency": 3
  },
  "Trace": {
    "MaxHops": 30,
    "TimeoutMs": 3000,
    "ResolveNames": true,
    "Engine": "tracert"
  },
  "Logging": {
    "LogDirectory": "",
    "LogPayloads": true,
    "RetentionDays": 30
  },
  "Listener": {
    "Address": "0.0.0.0",
    "Port": 2323,
    "Backlog": 10,
    "ResponseEnabled": false,
    "ResponseMessage": "HELLO FROM NETDIAG",
    "Encoding": "UTF-8",
    "Append": "CRLF",
    "Timing": "AfterData",
    "ReceiveTimeoutMs": 5000,
    "KeepOpen": false
  },
  "Ui": {
    "StartPage": "Dashboard",
    "MinimizeToTray": false,
    "CloseToTray": false,
    "ConfirmOnExit": true,
    "PortAutoRefreshSeconds": 5,
    "ShowTrayNotifications": true
  },
  "Smtp": {
    "Server": "",
    "Port": 587,
    "Security": "StartTls",
    "Username": "",
    "ProtectedPassword": "",
    "FromAddress": "",
    "DisplayName": "NetDiag Tool",
    "DefaultRecipient": "",
    "Cc": "",
    "Bcc": "",
    "TimeoutMs": 30000,
    "AcceptInvalidCertificates": false,
    "IsConfigured": false
  },
  "Monitoring": {
    "HistoryRetentionDays": 30,
    "SlowThresholdMs": 200,
    "AutoStartEnabledProfiles": false,
    "SchedulerEnabled": true
  },
  "Dns": {
    "Servers": [
      "8.8.8.8",
      "1.1.1.1"
    ],
    "TimeoutMs": 3000
  }
}
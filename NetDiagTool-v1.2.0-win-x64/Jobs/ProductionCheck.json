{
  "Name": "ProductionCheck",
  "Description": "Sample job: ping + TCP checks, trace the failures, HTML report, email only when something failed.",
  "Enabled": true,
  "Stages": [
    { "Type": "Ping", "Name": "Ping servers", "CsvFile": "Sample_Ping.csv", "Count": 2, "TimeoutMs": 2000, "Concurrency": 10 },
    { "Type": "Tcp", "Name": "Check ports", "CsvFile": "Sample_TCP.csv", "TimeoutMs": 3000, "Retries": 1, "Concurrency": 10 },
    { "Type": "TraceFailed", "Name": "Trace failures", "MaxHops": 15, "TimeoutMs": 1000, "Concurrency": 5 },
    { "Type": "Report", "Name": "HTML report", "ReportFormat": "Html" },
    { "Type": "Email", "Name": "Email on failure", "EmailOnlyOnFailure": true }
  ],
  "Schedule": { "Mode": "None", "Interval": 15, "TimeOfDay": "08:00", "DayOfWeek": "Monday", "RunAt": null }
}

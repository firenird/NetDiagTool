<Window x:Class="NetDiagTool.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="NetDiag Tool V1.0" Width="1280" Height="720"><DockPanel><TextBlock DockPanel.Dock="Bottom" Background="#17324D" Foreground="White" Padding="10" Text="{Binding Status}"/><TabControl Margin="10"><TabItem Header="Dashboard"><DataGrid ItemsSource="{Binding History}" IsReadOnly="True"/></TabItem><TabItem Header="Ping"><DockPanel><StackPanel DockPanel.Dock="Top" Orientation="Horizontal"><TextBox Width="220" Text="{Binding Target}"/><TextBox Width="70" Text="{Binding Count}"/><TextBox Width="90" Text="{Binding Timeout}"/><Button Content="Ping" Command="{Binding Ping}"/><Button Content="Stop" Command="{Binding Stop}"/><Button Content="Bulk CSV" Command="{Binding BulkPing}"/><Button Content="Export" Command="{Binding ExportPing}"/></StackPanel><DataGrid ItemsSource="{Binding PingResults}" IsReadOnly="True"/></DockPanel></TabItem><TabItem Header="TCP / Telnet"><DockPanel><StackPanel DockPanel.Dock="Top" Orientation="Horizontal"><TextBox Width="220" Text="{Binding Target}"/><TextBox Width="70" Text="{Binding Port}"/><Button Content="Test" Command="{Binding Tcp}"/><Button Content="Stop" Command="{Binding Stop}"/><Button Content="Bulk CSV" Command="{Binding BulkTcp}"/><Button Content="Export" Command="{Binding ExportTcp}"/></StackPanel><DataGrid ItemsSource="{Binding TcpResults}" IsReadOnly="True"/></DockPanel></TabItem><TabItem Header="Trace Route"><DockPanel><StackPanel DockPanel.Dock="Top" Orientation="Horizontal"><TextBox Width="220" Text="{Binding Target}"/><Button Content="Trace" Command="{Binding Trace}"/><Button Content="Stop" Command="{Binding Stop}"/></StackPanel><ListBox ItemsSource="{Binding TraceOutput}" FontFamily="Consolas"/></DockPanel></TabItem><TabItem Header="Port Monitor"><DockPanel><StackPanel DockPanel.Dock="Top" Orientation="Horizontal"><TextBox Width="260" Text="{Binding Filter,UpdateSourceTrigger=PropertyChanged}"/><Button Content="Refresh" Command="{Binding RefreshPorts}"/></StackPanel><DataGrid ItemsSource="{Binding PortView}" IsReadOnly="True"/></DockPanel></TabItem><TabItem Header="Logs / Settings"><StackPanel Margin="20"><TextBlock Text="Logs and config are stored beside the EXE."/><Button Width="160" Content="Open Log Folder" Command="{Binding OpenLogs}"/></StackPanel></TabItem></TabControl></DockPanel></Window>